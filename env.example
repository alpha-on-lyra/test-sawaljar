# Copy this file to .env.local for local testing. Never commit .env.local (it is in .gitignore).
# In Cloudflare Pages, add the same names under Settings > Variables and Secrets.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=G-59VVQC2SGQ
# Optional: extra allow-list of admin emails (comma separated)
NEXT_PUBLIC_ADMIN_EMAILS=

# Private (only the Cloudflare analytics function reads these; set them as Secrets in Cloudflare)
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
